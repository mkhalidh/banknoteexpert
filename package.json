{
  "name": "banknoteexpert",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "audit:links": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit-links.ts",
    "check:data": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-data.ts",
    "preflight": "npx next typegen && npm run lint && npx tsc -p tsconfig.json --noEmit && npx vitest run && npm run build && npm run audit:links && npm run check:data",
    "postbuild": "npm run check:metadata",
    "check:metadata": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit-seo.mjs --metadata-only",
    "audit:seo": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit-seo.mjs",
    "check:value-anomalies": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-value-anomalies.ts",
    "perf:seo": "node scripts/measure-seo-performance.mjs"
  },
  "dependencies": {
    "@waline/client": "^3.15.2",
    "@waline/vercel": "^1.41.6",
    "i18n-iso-countries": "^7.14.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "lighthouse": "^12.8.2",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0",
    "jsdom": "19.0.0"
  },
  "overrides": {
    "jsdom": "19.0.0"
  }
}
